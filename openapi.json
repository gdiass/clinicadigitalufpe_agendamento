    "/api/v1/cadastro/clinicas": {
      "get": {
        "description": "Lista as clínicas do Cadastro, usada nos filtros das telas da Agenda.",
        "operationId": "CadastroController_listarClinicas",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lista de clínicas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClinicaDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "501": {
            "description": "Integração com o Cadastro ainda não implementada (CADASTRO_PROVIDER=http)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "Listar clínicas",
        "tags": [
          "cadastro"
        ]
      }
    }
  },
  "info": {
    "title": "AppStart API",
    "description": "API REST do AppStart - Especificação OpenAPI 3.0",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://appstart.example/problems/validation-error"
          },
          "title": {
            "type": "string",
            "example": "Dados inválidos"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Um ou mais campos precisam ser corrigidos."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/users"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "requestId": {
            "type": "string",
            "example": "01J..."
          },
          "timestamp": {
            "type": "string",
            "example": "2026-08-31T20:00:00.000Z"
          },
          "errors": {
            "type": "object",
            "example": {
              "email": [
                "Informe um e-mail válido."
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "timestamp"
        ]
      },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Título da tarefa",
            "example": "Configurar monitoramento de produção",
            "minLength": 3,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "description": "Descrição detalhada da tarefa",
            "example": "Definir alertas para uso de CPU e memória.",
            "maxLength": 1000
          },
          "priority": {
            "type": "string",
            "description": "Prioridade da tarefa",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "URGENT"
            ],
            "default": "MEDIUM"
          },
          "dueDate": {
            "type": "string",
            "description": "Data de entrega limite (ISO 8601)",
            "example": "2026-12-31T23:59:59.000Z"
          }
        },
        "required": [
          "title"
        ]
      },
      "TaskOwnerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único do proprietário",
            "example": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"
          },
          "name": {
            "type": "string",
            "description": "Nome do proprietário",
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "description": "E-mail do proprietário",
            "example": "ada@example.com"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "TaskDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único da tarefa",
            "example": "b0eebc99-9c0b-4ef8-bb6d-6bb9bd380a22"
          },
          "title": {
            "type": "string",
            "description": "Título da tarefa",
            "example": "Configurar monitoramento"
          },
          "description": {
            "type": "object",
            "description": "Descrição da tarefa",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Status da tarefa",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED"
            ],
            "example": "PENDING"
          },
          "priority": {
            "type": "string",
            "description": "Prioridade da tarefa",
